{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reader worksheet response",
  "type": "object",
  "required": [
    "worksheet_id",
    "responses"
  ],
  "properties": {
    "worksheet_id": {
      "type": "string",
      "pattern": "^(chapter-[0-9]{2}|final-book)$"
    },
    "reader_key": {
      "type": "string",
      "description": "Optional pseudonymous key; omit for anonymous responses."
    },
    "responses": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 5
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
